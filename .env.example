# Cấu hình môi trường cho Agentic RAG Day 7
# Sao chép file này thành .env và điền API Key thực tế của bạn trước khi chạy benchmark

# API Key cho LLM Controller (OpenAI hoặc Gemini qua proxy)
OPENAI_API_KEY=your_api_key_here
GEMINI_API_KEY=your_api_key_here

# Base URL (Mặc định dùng proxy Gemini 3.8 Flash hoặc OpenAI endpoint)
OPENAI_BASE_URL=https://ai.starimg.ru/v1/chat/completions
